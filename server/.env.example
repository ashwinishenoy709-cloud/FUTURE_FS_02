# Mongo connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/apexlead?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# How long an auth token stays valid
JWT_EXPIRES_IN=7d

# Port the API listens on (Render sets this automatically)
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5174
